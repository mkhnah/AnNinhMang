# Environment Mode
ENVIRONMENT=development
DEBUG=true

# Database Configuration (SQLite default for Native Mode)
DATABASE_URL=sqlite:///./data/db/docsign.db

# Storage Configuration (Local filesystem default)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage/documents

# Security & Cryptography Keys (Generate random 32-byte hex for production)
SECRET_KEY=change_this_to_a_random_32_bytes_hex_for_production
JWT_SECRET_KEY=change_this_jwt_secret_key_for_production
JWT_ALGORITHM=HS256

# Session & Token Lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173

# Brute-force & Account Protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
