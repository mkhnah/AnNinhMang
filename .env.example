# Environment Mode
ENVIRONMENT=development
DEBUG=true

# Database Configuration (SQLite default for Native Mode)
DATABASE_URL=sqlite:///./data/db/docsign.db

# Storage Configuration (Local filesystem default)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage/documents

# Security & Cryptography Keys (Generate random 32-byte hex for production)
SECRET_KEY=change_this_to_a_random_32_bytes_hex_for_production
JWT_SECRET_KEY=change_this_jwt_secret_key_for_production
JWT_ALGORITHM=HS256

# Private CA. Initialize with scripts/init_ca.py before enabling PKI.
PKI_ENABLED=false
CA_PRIVATE_KEY_PATH=
CA_PRIVATE_KEY_PASSWORD_FILE=
CA_CERTIFICATE_PATH=
CA_TRUSTED_ROOT_SHA256=
CA_ADDITIONAL_TRUSTED_ROOT_SHA256=
CA_USER_CERT_VALIDITY_DAYS=365
PKI_CERTIFICATES_PER_DAY=60
# Internal RFC 3161 TSA: initialize with scripts/init_tsa.py in the Linux filesystem.
TSA_ENABLED=false
TSA_OPENSSL_BINARY=openssl
TSA_CERTIFICATE_PATH=
TSA_PRIVATE_KEY_PATH=
TSA_PRIVATE_KEY_PASSWORD_FILE=
TSA_CA_CERTIFICATE_PATH=
TSA_ROOT_SHA256=
TSA_SIGNER_SHA256=
TSA_TIMEOUT_SECONDS=10
# Alternative to password file: inject CA_PRIVATE_KEY_PASSWORD through the process environment.

# Session & Token Lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_BASE_URL=http://localhost:5173
SHARE_DEFAULT_EXPIRY_DAYS=7
SHARE_MAX_EXPIRY_DAYS=30

# Brute-force & Account Protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Phase 2: bytes, wall timeout, CPU and RSS budgets
MAX_UPLOAD_BYTES=20971520
PDF_TIMEOUT_SECONDS=10
PDF_CPU_SECONDS=6
PDF_MEMORY_MB=256
PDF_MAX_OBJECTS=50000
PDF_MAX_DEPTH=64
